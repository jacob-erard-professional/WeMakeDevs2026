# Copy to .env (gitignored) and fill in. Never commit real values.

# --- OpenAI ($50 credits per participant) ---
OPENAI_API_KEY=

# --- Elasticsearch (shared Elastic Cloud Serverless project) ---
# ES_URL is the project's endpoint and is not secret. Create your own API key in the
# project (Manage / Kibana -> API keys, or the project's "Connection details") or get
# the shared one out-of-band. Same ES_URL from this machine and from pods: dev-up.sh
# puts both values in the `elasticsearch` Secret (envFrom: secretRef: name: elasticsearch).
ES_URL=https://my-elasticsearch-project-ec6837.es.us-east4.gcp.elastic.cloud:443
ES_API_KEY=

# --- Dash0 via OpenTelemetry ---
# Copy the endpoint and token from Dash0's in-app onboarding (it pre-fills them),
# e.g. app.dash0.com -> Onboarding -> OpenTelemetry / your language.
OTEL_SERVICE_NAME=wemakedevs2026
OTEL_RESOURCE_ATTRIBUTES=vcs.repository.url.full=https://github.com/jacob-erard-professional/WeMakeDevs2026,service.namespace=wemakedevs2026
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <DASH0_AUTH_TOKEN>,Dash0-Dataset=default"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
