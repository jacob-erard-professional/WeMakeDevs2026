# Copy to .env (gitignored) and fill in. Never commit real values.

# --- OpenRouter (schedule extraction) ---
OPENROUTER_API_KEY=<OPENROUTER_API_KEY>
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional attribution headers used by OpenRouter
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=WeMakeDevs2026

# --- Organizer API ---
ORGANIZER_API_KEY=<GENERATE_A_LONG_RANDOM_SECRET>
PUBLIC_BASE_URL=http://localhost:8000
SCHEDULE_DRAFT_TTL_HOURS=24
SCHEDULE_MAX_UPLOAD_BYTES=20971520

# --- Elasticsearch (values from ../elastic-start-local/.env) ---
# From this machine: http://localhost:9200   From pods: http://elasticsearch:9200
ES_URL=http://localhost:9200
ES_API_KEY=

# --- Dash0 via OpenTelemetry ---
# Copy the endpoint and token from Dash0's in-app onboarding (it pre-fills them),
# e.g. app.dash0.com -> Onboarding -> OpenTelemetry / your language.
OTEL_SERVICE_NAME=wemakedevs2026-backend
OTEL_RESOURCE_ATTRIBUTES=vcs.repository.url.full=https://github.com/jacob-erard-professional/WeMakeDevs2026,service.namespace=wemakedevs2026
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <DASH0_AUTH_TOKEN>,Dash0-Dataset=default"
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
