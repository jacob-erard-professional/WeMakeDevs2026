# Serves the Expo web export and proxies /api/* to the backend Service in the same namespace.
# Rendered by the image entrypoint into /tmp/default.conf; only the two
# ${...} variables below are substituted (NGINX_ENVSUBST_FILTER in the Dockerfile).
server {
    listen 8080;
    server_name _;

    # Resolve the backend per request through the pod's DNS instead of once at startup, so nginx
    # starts before the backend Service exists and follows it if its ClusterIP changes.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml application/wasm font/ttf font/otf;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Probes. Answered by nginx itself, never by the static tree or the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Same-origin API: /api/health -> http://backend/health (Service backend, port 80).
    location /api/ {
        set $backend http://${BACKEND_UPSTREAM};
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_send_timeout 90s;
        # Schedule import fetches slow sources (Sched takes ~21 s to first byte) and may call the LLM.
        proxy_read_timeout 90s;
        proxy_buffering off;
        client_max_body_size 10m;
    }

    # Expo writes content-hashed bundles and assets; cache them hard.
    location /_expo/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri =404;
    }

    # SPA: unknown paths render the app shell. The shell itself is never cached.
    location / {
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ /index.html;
    }
}
